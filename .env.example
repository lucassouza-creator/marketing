# LearnWorlds API
LEARNWORLDS_URL=https://academy.indicium.ai/admin/api
LEARNWORLDS_CLIENT_ID=your_client_id_here
LEARNWORLDS_CLIENT_SECRET=your_client_secret_here

# Google Sheets
# Opção 1: caminho para o arquivo JSON da service account
GOOGLE_SERVICE_ACCOUNT_FILE=google-credentials.json

# Opção 2: conteúdo JSON direto (útil em CI/CD)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Email para compartilhar a planilha gerada (opcional)
GOOGLE_SHARE_EMAIL=seuemail@indicium.ai
